<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<!-- Release builds from GitHub: signed with Developer ID under the hardened runtime, then notarized.
     Music sync records what the Mac plays through a Core Audio tap, which the hardened runtime allows only
     with audio input. -->
<plist version="1.0">
<dict>
	<key>com.apple.security.device.audio-input</key>
	<true/>
</dict>
</plist>
