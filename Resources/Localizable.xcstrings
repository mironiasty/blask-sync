    "No bridges found. Check that this Mac is on the same network, or enter the bridge's IP.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Bridges gefunden. Prüfen Sie, ob dieser Mac im selben Netzwerk ist, oder geben Sie die IP-Adresse der Bridge ein."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "No se encontraron puentes. Comprueba que este Mac está en la misma red o introduce la IP del puente."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Aucun pont trouvé. Vérifiez que ce Mac est sur le même réseau ou saisissez l’adresse IP du pont."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Nie znaleziono mostków. Sprawdź, czy ten Mac jest w tej samej sieci, lub wpisz adres IP mostka."
          }
        }
      }
    },
    "No entertainment areas found. Create one in the Hue app under Settings → Entertainment areas.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Keine Entertainment-Bereiche gefunden. Erstellen Sie einen in der Hue App unter Einstellungen → Entertainment-Bereiche."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
