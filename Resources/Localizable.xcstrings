        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Wenn die Anzeigen bei laufender Musik stillstehen, erlauben Sie Blask Sync unter Systemeinstellungen → Datenschutz & Sicherheit → Bildschirm- & Systemaudioaufnahme im Abschnitt „Nur Systemaudioaufnahme“."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Si los medidores no se mueven mientras suena música, permite Blask Sync en Ajustes del Sistema → Privacidad y seguridad → Grabación de pantalla y audio del sistema, en Solo grabación de audio del sistema."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Si les indicateurs restent immobiles pendant la lecture, autorisez Blask Sync dans Réglages Système → Confidentialité et sécurité → Enregistrement de l’écran et de l’audio système, sous Enregistrement de l’audio système uniquement."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Jeśli wskaźniki stoją w miejscu, gdy gra muzyka, zezwól na Blask Sync w Ustawieniach systemowych → Prywatność i ochrona → Nagrywanie ekranu i dźwięku systemowego, w sekcji Tylko nagrywanie dźwięku systemowego."
          }
        }
      }
    },
    "Intensity": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensität"
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensidad"
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensité"
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Intensywność"
          }
        }
      }
    },
    "Keeps the lights glowing faintly in dark scenes instead of switching off.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lässt die Lichter in dunklen Szenen schwach leuchten, statt sie auszuschalten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Mantiene las luces con un brillo tenue en escenas oscuras en lugar de apagarse."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Garde les lumières faiblement allumées dans les scènes sombres au lieu de les éteindre."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "W ciemnych scenach światła delikatnie się żarzą zamiast gasnąć."
          }
        }
      }
    },
    "Lamp beside the screen. Follows the nearest screen area (outlined), mixed with %lld%% of the overall screen color.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampe neben dem Bildschirm. Folgt dem nächsten Bildschirmbereich (umrandet), gemischt mit %lld %% der Gesamtfarbe des Bildschirms."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lámpara junto a la pantalla. Sigue el área de pantalla más cercana (con contorno), mezclada con un %lld %% del color general de la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampe à côté de l’écran. Suit la zone d’écran la plus proche (encadrée), mélangée à %lld %% de la couleur globale de l’écran."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampa obok ekranu. Podąża za najbliższym obszarem ekranu (obrysowanym), zmieszanym w %lld%% z ogólnym kolorem ekranu."
          }
        }
      }
    },
    "Lamp on the screen. Follows the area under it. Drag it onto the wall if it stands beside the screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampe auf dem Bildschirm. Folgt dem Bereich darunter. Ziehen Sie sie auf die Wand, wenn sie neben dem Bildschirm steht."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Lámpara en la pantalla. Sigue el área que tiene debajo. Arrástrala a la pared si está junto a la pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampe sur l’écran. Suit la zone située en dessous. Faites-la glisser sur le mur si elle est à côté de l’écran."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampa na ekranie. Podąża za obszarem pod sobą. Przeciągnij ją na ścianę, jeśli stoi obok ekranu."
          }
        }
      }
    },
    "Lamp: on the screen or beside it": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Lampe: auf dem Bildschirm oder daneben"
          }
