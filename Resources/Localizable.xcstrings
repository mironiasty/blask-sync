          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Rytm"
          }
        }
      }
    },
    "Blask Sync drives this area when you start sync from the menu bar.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blask Sync steuert diesen Bereich, wenn Sie die Synchronisation in der Menüleiste starten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blask Sync controla esta área cuando inicias la sincronización desde la barra de menús."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blask Sync pilote cette zone quand vous lancez la synchronisation depuis la barre des menus."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blask Sync steruje tym obszarem, gdy uruchomisz synchronizację z paska menu."
          }
        }
      }
    },
    "Blask Sync needs Screen Recording permission to sample your screen.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Blask Sync benötigt die Berechtigung zur Bildschirmaufnahme, um Ihren Bildschirm auszuwerten."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "Blask Sync necesita permiso de grabación de pantalla para analizar tu pantalla."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Blask Sync a besoin de l’autorisation d’enregistrement de l’écran pour analyser votre écran."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Blask Sync potrzebuje uprawnienia do nagrywania ekranu, aby odczytywać jego kolory."
          }
        }
      }
    },
