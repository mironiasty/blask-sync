    "The bridge didn't accept the streaming connection in time.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bridge hat die Streaming-Verbindung nicht rechtzeitig angenommen."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puente no aceptó la conexión de transmisión a tiempo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pont n’a pas accepté la connexion de diffusion à temps."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostek nie przyjął połączenia transmisji na czas."
          }
        }
      }
    },
    "The bridge didn't return a client key. Update the bridge firmware in the Hue app.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bridge hat keinen Client-Schlüssel geliefert. Aktualisieren Sie die Firmware der Bridge in der Hue App."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puente no devolvió una clave de cliente. Actualiza el firmware del puente en la app Hue."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pont n’a pas renvoyé de clé client. Mettez à jour le firmware du pont dans l’app Hue."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostek nie zwrócił klucza klienta. Uaktualnij oprogramowanie mostka w aplikacji Hue."
          }
        }
      }
    },
    "The bridge no longer accepts this app's key. Forget the bridge and pair again.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bridge akzeptiert den Schlüssel dieser App nicht mehr. Entfernen Sie die Bridge und koppeln Sie sie erneut."
          }
        },
        "es": {
          "stringUnit": {
            "state": "translated",
            "value": "El puente ya no acepta la clave de esta app. Olvida el puente y vuelve a enlazarlo."
          }
        },
        "fr": {
          "stringUnit": {
            "state": "translated",
            "value": "Le pont n’accepte plus la clé de cette app. Oubliez le pont et jumelez-le à nouveau."
          }
        },
        "pl": {
          "stringUnit": {
            "state": "translated",
            "value": "Mostek nie akceptuje już klucza tej aplikacji. Zapomnij mostek i sparuj go ponownie."
          }
        }
      }
    },
    "The bridge responded with HTTP %lld.": {
      "localizations": {
        "de": {
          "stringUnit": {
            "state": "translated",
            "value": "Die Bridge hat mit HTTP %lld geantwortet."
          }
